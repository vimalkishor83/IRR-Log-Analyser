# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///irr_app.db

# ── ServiceNow connection ──────────────────────────────────────────────────────
# Mock (local dev):
SERVICENOW_URL=http://localhost:8080
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=admin123

# Real ServiceNow (production) — uncomment and replace:
# SERVICENOW_URL=https://your-instance.service-now.com
# SERVICENOW_USERNAME=your_api_user
# SERVICENOW_PASSWORD=your_api_password

# How many seconds to wait for a ServiceNow API response before giving up
SERVICENOW_TIMEOUT=15

# ── Incident sync filtering ───────────────────────────────────────────────────
# Only pull incidents assigned to these ServiceNow groups.
# Use the exact group names as they appear in ServiceNow.
# Leave blank to sync ALL resolved/closed incidents (every team).
# Example — sync just two teams:
#   SERVICENOW_ASSIGNMENT_GROUPS=Application Support,Database Team
SERVICENOW_ASSIGNMENT_GROUPS=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# How many hours between automatic background syncs (default: 24 hours)
SYNC_INTERVAL_HOURS=24

# ── Recommendation engine ─────────────────────────────────────────────────────
# Minimum similarity score (0-100) to include a result in recommendations
CONFIDENCE_THRESHOLD=60

# ── File upload ───────────────────────────────────────────────────────────────
UPLOAD_TEMP_FOLDER=uploads

# ── Application log rotation ──────────────────────────────────────────────────
# Max size in bytes before a new log file is created (default: 5 MB)
LOG_MAX_BYTES=5242880

# Number of rotated log files to keep alongside the current one (default: 10)
LOG_BACKUP_COUNT=10

# Time-based rotation — when set this takes priority over LOG_MAX_BYTES.
# Options: "midnight" (daily), "h" (hourly), "m" (every minute)
# Leave blank to use size-based rotation only.
LOG_ROTATE_WHEN=
